# Environment Variables for Quiz Application
# Copy this file to .env.local for local development

# Next.js Configuration
NEXT_PUBLIC_APP_NAME="Quizlett"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (if you add database functionality later)
# DATABASE_URL="your-database-connection-string"
# NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Analytics (if you want to add analytics)
# NEXT_PUBLIC_GA_TRACKING_ID="your-google-analytics-id"
# NEXT_PUBLIC_GTM_ID="your-google-tag-manager-id"

# API Keys (for external services)
# NEXT_PUBLIC_API_BASE_URL="https://api.example.com"
# API_SECRET_KEY="your-secret-api-key"

# Vercel Analytics (already included in package.json)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID="your-vercel-analytics-id"

# Development/Production Environment
NODE_ENV="development"
